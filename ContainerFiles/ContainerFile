FROM golang:1.25-alpine AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/hawk-go ./main.go

FROM gcr.io/distroless/static-debian12:nonroot

WORKDIR /app
COPY --from=builder /out/hawk-go /app/hawk-go

ENV HAWK_CONFIG_PATH=/etc/hawk/configlist.yaml

ENTRYPOINT ["/app/hawk-go"]